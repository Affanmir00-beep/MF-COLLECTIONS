{
  "name": "vanya-clone-root",
  "version": "1.0.0",
  "description": "Root package for running client and server concurrently",
  "scripts": {
    "install:all": "npm install --prefix client && npm install --prefix server",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "start": "concurrently \"npm start --prefix server\" \"npm start --prefix client\"",
    "test": "npm test --prefix server"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "concurrently": "^8.2.2"
  }
}
